# Postgres
POSTGRES_USER=earnsight
POSTGRES_PASSWORD=earnsight
POSTGRES_DB=earnsight

# Backend
DATABASE_URL=postgresql+asyncpg://earnsight:earnsight@postgres:5432/earnsight
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
# Limite upload (MB). Se lo alzi, alza anche client_max_body_size in
# frontend/nginx/default.conf (oggi 11m = 10 MB + margine multipart).
MAX_UPLOAD_MB=10

# Auth (login singolo utente)
# SECRET_KEY obbligatoria (>= 32 caratteri, non placeholder): l'avvio fallisce
# senza, perché da essa deriva la chiave Fernet delle API key cifrate.
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
AUTH_USERNAME=admin
# AUTH_PASSWORD obbligatoria: vuota o "admin"/"change-me" → l'avvio fallisce.
# Il .env è la fonte di verità: cambiarla qui e riavviare aggiorna la password.
AUTH_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM gateway: "", "openai" o "ollama"
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
