# Postgres
POSTGRES_USER=earnsight
POSTGRES_PASSWORD=earnsight
POSTGRES_DB=earnsight

# Backend
DATABASE_URL=postgresql+asyncpg://earnsight:earnsight@postgres:5432/earnsight
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data

# Auth (login singolo utente)
SECRET_KEY=change-me-with-a-long-random-string
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM gateway: "", "openai" o "ollama"
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
